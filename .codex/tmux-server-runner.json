{
  "window": "servers",
  "startupWaitSeconds": 120,
  "services": [
    {
      "name": "codex-proxy",
      "command": "./local/codex-proxy/run.sh",
      "cwd": ".",
      "port": 10531
    },
    {
      "name": "web",
      "command": "pnpm exec next dev -p 3007 --hostname 0.0.0.0",
      "cwd": ".",
      "port": 3007,
      "health": {
        "url": "http://127.0.0.1:3007/api/healthz",
        "expectStatus": [200]
      }
    },
    {
      "name": "worker",
      "command": "pnpm worker",
      "cwd": "."
    }
  ],
  "checks": [
    {
      "name": "web ready",
      "url": "http://127.0.0.1:3007/api/readyz",
      "expectStatus": [200]
    }
  ]
}
