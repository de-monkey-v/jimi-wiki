{
  "name": "jimi-wiki-app",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev -p 3007",
    "dev:all": "tsx scripts/dev-all.ts",
    "start:all": "tsx scripts/dev-all.ts start",
    "build": "next build",
    "start": "next start -p 3007",
    "worker": "NODE_OPTIONS='-r ./scripts/server-only-shim.cjs' tsx scripts/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS='-r ./scripts/server-only-shim.cjs' node --import tsx --test src/lib/*.test.ts",
    "test:integration": "NODE_OPTIONS='-r ./scripts/server-only-shim.cjs' node --import tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "lint": "eslint",
    "db:up": "docker compose up -d",
    "db:seed": "tsx prisma/seed.ts",
    "db:migrate": "prisma migrate dev",
    "apikey:issue": "tsx scripts/issue-api-key.ts",
    "reindex": "NODE_OPTIONS='-r ./scripts/server-only-shim.cjs' tsx scripts/reindex-embeddings.ts",
    "telegram:seed": "NODE_OPTIONS='-r ./scripts/server-only-shim.cjs' tsx scripts/telegram-seed.ts",
    "telegram:webhook": "tsx scripts/telegram-setup-webhook.ts",
    "telegram:simulate": "tsx scripts/telegram-simulate.ts",
    "backfill:sources": "NODE_OPTIONS='-r ./scripts/server-only-shim.cjs' tsx scripts/backfill-orphan-source-notes.ts",
    "refetch:source": "NODE_OPTIONS='-r ./scripts/server-only-shim.cjs' tsx scripts/refetch-source-body.ts",
    "openai:login": "tsx scripts/openai-login.ts",
    "openai:smoke": "NODE_OPTIONS='-r ./scripts/server-only-shim.cjs' tsx scripts/openai-oauth-smoke.ts",
    "openai:configure-test": "NODE_OPTIONS='-r ./scripts/server-only-shim.cjs' tsx scripts/configure-test-models.ts",
    "reset:test-content": "NODE_OPTIONS='-r ./scripts/server-only-shim.cjs' tsx scripts/reset-test-content.ts",
    "smoke": "NODE_OPTIONS='-r ./scripts/server-only-shim.cjs' tsx scripts/smoke.ts",
    "check:rules": "node scripts/check-rules-parity.mjs",
    "check:content-writes": "node scripts/check-content-writes.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "mcp": "node mcp/server.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.88",
    "@ai-sdk/openai": "^3.0.80",
    "@ai-sdk/react": "^3.0.220",
    "@anthropic-ai/sdk": "^0.110.0",
    "@auth/prisma-adapter": "^2.11.2",
    "@extractus/article-extractor": "^8.1.0",
    "@google/genai": "^2.10.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/client-runtime-utils": "^7.8.0",
    "@sigma/node-border": "3.0.0",
    "ai": "^6.0.218",
    "diff": "9.0.0",
    "dotenv": "^17.4.2",
    "github-slugger": "^2.0.0",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "graphology-layout-noverlap": "0.4.2",
    "mammoth": "^1.12.0",
    "next": "16.2.10",
    "next-auth": "5.0.0-beta.31",
    "next-intl": "4.13.1",
    "officeparser": "^7.2.3",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sigma": "^3.0.3",
    "streamdown": "2.5.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "unpdf": "^1.6.2",
    "yauzl": "^3.4.0",
    "youtube-caption-extractor": "^1.10.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yauzl": "^3.4.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
