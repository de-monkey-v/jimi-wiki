// jimi-wiki 플랫폼 데이터 모델 — docs/jimi-wiki-platform.md §4 참조
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  output          = "../src/generated/prisma"
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// ---------- enums ----------
enum Role {
  owner
  editor
  viewer
}

enum Visibility {
  private
  unlisted
  public
}

enum WikiKind {
  personal
  project
  channel
}

enum PageKind {
  note
  concept
  entity
  document // 작업 기록·결정·문제 해결·계획 등 독립 문서. Source provenance와 KnowledgeBuild 자동 재작성에서 제외
  meta
  personal // 개인 수동 메모. 폴더 트리에 참여하되 AI(임베딩·검색·ingest·query·chat·lint·번역)에서 완전 제외
}

enum DocumentType {
  general
  worklog
  troubleshooting
  decision
  reference
  plan
  spec
  research
}

enum SourceCurationState {
  preserved
  curated
}

enum LogKind {
  ingest
  query
  lint
  ontology
}

enum AgentType {
  ingest
  query
  lint
  rebuild
}

enum AgentStatus {
  pending
  running
  done
  error
}

enum PageOrigin {
  human
  generated
  mixed
  system
}

enum ModelAccess {
  external
  internalOnly
}

enum RevisionActor {
  human
  agent
  system
  restore
}

enum BuildMode {
  incremental
  full
  restore
}

enum BuildStatus {
  pending
  running
  review
  published
  publishedDegraded
  failed
  cancelled
}

enum DraftStatus {
  staged
  conflict
  published
  accepted
  rejected
  stale
  suppressed
}

// ---------- 앱 전역 설정 (단일행) ----------
// 런타임에 UI(관리자)에서 바꾸는 설정. env 는 미설정 시 폴백. web·worker 가 같은 행을 읽는다.
// ⚠️ EMBED_MODEL/EMBED_DIM 은 DB vector 컬럼·HNSW 인덱스와 결합되어 여기 두지 않는다(env 고정).
model AppConfig {
  id               String   @id @default("singleton")
  chatModel        String? // 위키 채팅. null=env CHAT_MODEL 폴백
  genModel         String? // query·lint 등 일반 생성. null=env GEN_MODEL 폴백
  ingestModel      String? // ingest 에이전트. null=env INGEST_MODEL 폴백
  openaiTransport  String? // OpenAI 연결 방식: apikey|oauth|proxy. null=env(OPENAI_TRANSPORT)/auto 폴백
  // opt-in: 관리자가 명시적으로 켠 provider 만 사용(키 존재 ≠ 자동 사용). 값: google|openai|anthropic.
  // 행이 없을 때만 env ENABLED_PROVIDERS 로 폴백(스칼라 배열은 null 불가).
  enabledProviders String[] @default([])
  updatedAt        DateTime @updatedAt
}

// ---------- 인증 (Auth.js) ----------
model User {
  id             String       @id @default(cuid())
  email          String       @unique
  name           String?
  image          String?
  emailVerified  DateTime?
  passwordHash   String? // argon2id 해시. null=비밀번호 미설정(oidc/single/미부트스트랩 기존 유저)
  isAdmin        Boolean      @default(false) // 인스턴스 관리자(유저·초대 관리 권한). 위키별 Role과 직교
  locale         String? // 선호 UI 언어(ko/en/ja/zh). 기기 간 유지용 — 쿠키 부재 시 폴백
  createdAt      DateTime     @default(now())
  accounts       Account[] // 유지(JWT 전환 후 idle) — oidc 확장 시 재사용
  sessions       Session[] // 유지(JWT 전환 후 idle)
  memberships    Membership[]
  createdWikis   Wiki[]       @relation("WikiCreatedBy")
  apiKeys        ApiKey[]
  createdInvites Invite[]     @relation("InviteCreatedBy")
  pagePins       PagePin[]
  folderPins     FolderPin[]
  savedLinks     SavedLink[]
}

// ---------- 인스턴스 계정 초대 (가입 게이트) ----------
// ShareLink(위키 스코프 공유)와 달리 wikiId가 선택이며 '새 유저 계정 발급'을 의미한다.
// 공개 회원가입은 없다 — 관리자가 발급한 이 토큰으로만 계정을 만들 수 있다.
model Invite {
  id           String    @id @default(cuid())
  token        String    @unique // 고엔트로피 무작위(crypto.randomBytes(24).base64url). 초대 URL에 실림
  email        String? // 지정 시 이 이메일만 가입 허용
  wikiId       String? // 지정 시 가입과 동시에 이 위키 멤버로 추가. null=계정만 생성
  role         Role      @default(viewer) // wikiId가 있을 때 부여할 위키 역할
  expiresAt    DateTime? // null=무만료. now 이후면 사용 불가
  usedAt       DateTime? // 소비 시각(1회용 게이트). null=미사용
  usedByUserId String? // 이 초대로 가입한 유저(소프트 참조)
  createdById  String
  createdAt    DateTime  @default(now())
  createdBy    User      @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  wiki         Wiki?     @relation(fields: [wikiId], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@index([wikiId])
}

// ---------- API 키 인증 (프로그램적 호출용 Bearer 토큰) ----------
// 브라우저는 세션(위 Session/Account) 유지, API 라우트는 이 토큰으로 인증.
// 원문 키는 저장하지 않는다 — sha256(hashedKey)만 저장, prefix는 노출용 식별자.
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  wikiId     String? // 스코프 위키 — null=전체 위키(레거시). 값이 있으면 그 위키에서만 유효
  name       String // 사람이 식별하는 라벨 ("ingest-bot" 등)
  hashedKey  String    @unique // sha256(token) hex, 조회·비교 대상
  prefix     String // 토큰 앞부분(비밀 아님) — UI 표시/키 구분용
  maxRole    Role? // 상한 역할 — null=다운그레이드 없음(멤버십 역할 그대로). 유효역할=min(멤버십, maxRole)
  expiresAt  DateTime? // 만료 시각 — null=무만료. now 이후면 인증 실패
  revokedAt  DateTime? // 폐기 시각(soft-revoke) — null=활성. 하드삭제 대신 이 값을 채운다
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  wiki       Wiki?     @relation(fields: [wikiId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([wikiId])
}

// ---------- 사용량 계측 (LLM/임베딩 호출 단위 이벤트) ----------
// 스칼라 위주(관계 미연결) — 계측은 fire-and-forget이라 FK 제약/조인 비용을 피한다.
// userId/apiKeyId/wikiId는 컨텍스트가 있을 때만 채워지는 소프트 참조.
model UsageEvent {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  userId       String? // 호출 주체(세션/키 소유자). 컨텍스트 없으면 null
  apiKeyId     String? // API 키 호출이면 그 키 id
  wikiId       String? // 대상 위키
  buildId      String? // KnowledgeBuild 귀속(soft reference; build purge가 usage를 지우지 않음)
  phase        String? // extract|synthesize|publish|index 등 build 단계
  kind         String // "llm" | "embed"
  route        String   @default("") // 호출 출처("query"|"ingest"|"chat"|"lint"|"search"|"reindex" 등)
  model        String? // 사용 모델명
  inputTokens  Int?
  outputTokens Int?
  costUsd      Float?

  @@index([userId, createdAt])
  @@index([wikiId, createdAt])
  @@index([buildId, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- 테넌트 ----------
model Wiki {
  id               String            @id @default(cuid())
  slug             String            @unique
  title            String
  description      String?
  visibility       Visibility        @default(private)
  kind             WikiKind          @default(personal)
  createdById      String
  createdBy        User              @relation("WikiCreatedBy", fields: [createdById], references: [id])
  trashedAt        DateTime?
  purgeAt          DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  memberships      Membership[]
  pages            Page[]
  pageLinks        PageLink[]
  sources          Source[]
  chunks           SearchChunk[]
  conceptRelations ConceptRelation[]
  logs             LogEntry[]
  shareLinks       ShareLink[]
  agentRuns        AgentRun[]
  apiKeys          ApiKey[]
  invites          Invite[]
  pagePins         PagePin[]
  folderPins       FolderPin[]
  savedLinks       SavedLink[]
  telegramBindings TelegramBinding[]
  knowledgeBuilds  KnowledgeBuild[]

  @@index([trashedAt])
  @@index([purgeAt])
}

model Membership {
  id        String   @id @default(cuid())
  wikiId    String
  userId    String
  role      Role     @default(owner)
  createdAt DateTime @default(now())
  wiki      Wiki     @relation(fields: [wikiId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([wikiId, userId])
  @@index([userId])
}

model ShareLink {
  id        String    @id @default(cuid())
  wikiId    String
  token     String    @unique
  role      Role      @default(viewer)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  wiki      Wiki      @relation(fields: [wikiId], references: [id], onDelete: Cascade)
}

// ---------- 콘텐츠 ----------
model Page {
  id                   String                       @id @default(cuid())
  wikiId               String
  slug                 String
  title                String
  kind                 PageKind                     @default(note)
  frontmatter          Json                         @default("{}")
  body                 String                       @default("")
  sortOrder            Int                          @default(0) // 형제 페이지 간 순서(책 목차)
  parentId             String? // 상위 페이지(챕터). 루트는 null
  category             String? // 자유형 폴더 경로(예: "ai/architectures"). 온톨로지 조직 축
  documentType         DocumentType? // kind=document일 때 필수
  documentAt           DateTime? // 문서의 의미상 기록 시각. kind=document일 때 필수
  sourceId             String? // 이 페이지가 파생된 원문(provenance). note에 주로 연결
  origin               PageOrigin                   @default(human)
  modelAccess          ModelAccess                  @default(external)
  currentVersion       Int                          @default(1)
  policyVersion        Int                          @default(1)
  archivedAt           DateTime?
  trashedAt            DateTime?
  purgeAt              DateTime?
  archivedBeforeTrash  Boolean                      @default(false)
  suppressedAt         DateTime?
  staleAt              DateTime?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  wiki                 Wiki                         @relation(fields: [wikiId], references: [id], onDelete: Cascade)
  parent               Page?                        @relation("PageTree", fields: [parentId], references: [id], onDelete: SetNull)
  children             Page[]                       @relation("PageTree")
  source               Source?                      @relation("PageSource", fields: [sourceId], references: [id], onDelete: SetNull)
  outLinks             PageLink[]                   @relation("PageOut")
  inLinks              PageLink[]                   @relation("PageIn")
  contributions        PageContribution[] // 이 파생 페이지에 기여한 원본들(M:N provenance)
  relationsFrom        ConceptRelation[]            @relation("ConceptRelFrom") // 이 개념에서 나가는 타입드 관계
  relationsTo          ConceptRelation[]            @relation("ConceptRelTo") // 이 개념으로 들어오는 타입드 관계
  pins                 PagePin[] // 이 페이지를 고정한 유저들(개인 즐겨찾기)
  translations         PageTranslation[] // 온디맨드 기계 번역 캐시(언어별)
  revisions            PageRevision[]
  knowledgeDrafts      KnowledgeDraft[]
  buildManifestEntries KnowledgeBuildPageRevision[]

  @@unique([wikiId, slug])
  @@index([wikiId, kind])
  @@index([wikiId, kind, documentType, documentAt])
  @@index([wikiId, parentId, sortOrder])
  @@index([wikiId, category])
  @@index([wikiId, archivedAt])
  @@index([wikiId, trashedAt])
  @@index([purgeAt])
  @@index([wikiId, modelAccess, archivedAt])
}

model PageRevision {
  id                   String                       @id @default(cuid())
  pageId               String
  version              Int
  title                String
  body                 String
  kind                 PageKind
  frontmatter          Json                         @default("{}")
  category             String?
  documentType         DocumentType?
  documentAt           DateTime?
  parentId             String?
  sortOrder            Int
  sourceId             String?
  origin               PageOrigin
  modelAccess          ModelAccess
  archivedAt           DateTime?
  suppressedAt         DateTime?
  staleAt              DateTime?
  contentHash          String
  actor                RevisionActor
  reason               String?
  userId               String?
  agentRunId           String?
  buildId              String?
  createdAt            DateTime                     @default(now())
  page                 Page                         @relation(fields: [pageId], references: [id], onDelete: Cascade)
  build                KnowledgeBuild?              @relation("BuildCreatedPageRevisions", fields: [buildId], references: [id], onDelete: SetNull)
  sources              PageRevisionSource[]
  buildManifestEntries KnowledgeBuildPageRevision[]

  @@unique([pageId, version])
  @@index([buildId])
  @@index([createdAt])
}

model PageRevisionSource {
  id                 String          @id @default(cuid())
  pageRevisionId   String
  sourceRevisionId String?
  ordinal           Int?
  sourceRevisionRef String?
  sourceVersion     Int?
  sourceContentHash String?
  sourceSlug        String?
  purgedAt          DateTime?
  pageRevision     PageRevision   @relation(fields: [pageRevisionId], references: [id], onDelete: Cascade)
  sourceRevision   SourceRevision? @relation(fields: [sourceRevisionId], references: [id], onDelete: SetNull)

  @@unique([pageRevisionId, sourceRevisionId])
  @@unique([pageRevisionId, ordinal])
  @@index([sourceRevisionId])
  @@index([sourceRevisionRef])
}

// 온디맨드 기계 번역 캐시. (page, locale)당 1행. 원문이 바뀌면 sourceHash 불일치로 재번역.
model PageTranslation {
  id         String   @id @default(cuid())
  pageId     String
  locale     String // 대상 언어(en/ja/zh/ko)
  sourceHash String // 번역 시점 원문(title+body) 해시 — 불일치면 stale
  title      String
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  page       Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, locale])
}

model PageLink {
  id         String  @id @default(cuid())
  wikiId     String
  fromPageId String
  toSlug     String
  toPageId   String?
  wiki       Wiki    @relation(fields: [wikiId], references: [id], onDelete: Cascade)
  from       Page    @relation("PageOut", fields: [fromPageId], references: [id], onDelete: Cascade)
  to         Page?   @relation("PageIn", fields: [toPageId], references: [id], onDelete: SetNull)

  @@index([wikiId, toPageId])
  @@index([wikiId, toSlug])
  @@index([fromPageId])
}

model Source {
  id             String              @id @default(cuid())
  wikiId         String
  slug           String
  title          String
  url            String?
  body           String?
  storageKey     String?
  modelAccess    ModelAccess         @default(external)
  curationState  SourceCurationState @default(curated)
  currentVersion Int                 @default(1)
  policyVersion  Int                 @default(1)
  archivedAt     DateTime?
  trashedAt      DateTime?
  purgeAt        DateTime?
  archivedBeforeTrash Boolean            @default(false)
  ingestedAt     DateTime            @default(now())
  wiki           Wiki                @relation(fields: [wikiId], references: [id], onDelete: Cascade)
  pages          Page[]              @relation("PageSource")
  contributions  PageContribution[]  @relation("SourceContribs") // 이 원본이 기여한 파생 페이지들
  relations      ConceptRelation[]   @relation("SourceRelations") // 이 원본이 근거로 만든 개념 관계(접지)
  revisions      SourceRevision[]

  @@unique([wikiId, slug])
  @@index([wikiId, archivedAt])
  @@index([wikiId, trashedAt])
  @@index([purgeAt])
  @@index([wikiId, modelAccess, archivedAt])
  @@index([wikiId, curationState, archivedAt])
}

model SourceRevision {
  id               String                     @id @default(cuid())
  sourceId         String
  version          Int
  title            String
  url              String?
  body             String?
  storageKey       String?
  modelAccess      ModelAccess
  archivedAt       DateTime?
  contentHash      String
  actor            RevisionActor
  reason           String?
  userId           String?
  agentRunId       String?
  buildId          String?
  createdAt        DateTime                   @default(now())
  source           Source                     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  pageRevisions    PageRevisionSource[]
  extractions      SourceExtraction[]
  draftSources     KnowledgeDraftSource[]
  buildExtractions KnowledgeBuildExtraction[]
  conceptRelations ConceptRelation[]

  @@unique([sourceId, version])
  @@index([buildId])
  @@index([createdAt])
}

// 파생 페이지(concept/entity) ↔ 기여 원본(Source)의 M:N. note의 단일 Page.sourceId와 별개.
model PageContribution {
  id       String @id @default(cuid())
  wikiId   String
  pageId   String
  sourceId String
  page     Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  source   Source @relation("SourceContribs", fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([pageId, sourceId])
  @@index([sourceId])
}

// 개념 간 타입드 관계(knowledge graph 엣지). 무타입 위키링크(PageLink)와 별개 레이어.
enum RelationType {
  relatedTo // 대칭(무향) 기본. coerceRelType의 fallback
  partOf
  causes
  contrasts
  dependsOn
}

// 근거(Source)에 접지된 타입드 개념 엣지. PageContribution의 M:N provenance/cascade 규약을 따른다.
// 정체성 키에 sourceId 포함 → 같은 논리 엣지라도 원문마다 1행. 원문 삭제/재수집이 그 원문의 엣지만 정확히 지운다.
// 논리 dedup(무향 병합)은 순회(expandViaGraph) 시에만 한다. sourceId NOT NULL = 근거 없는 엣지는 존재하지 않는다(트러스트 모델).
model ConceptRelation {
  id               String         @id @default(cuid())
  wikiId           String
  fromPageId       String
  toPageId         String
  type             RelationType   @default(relatedTo)
  sourceId         String // 접지(grounding). 이 엣지를 만든 run의 원문. onDelete Cascade → 원문이 사라지면 엣지도 소멸
  sourceRevisionId String // 이 엣지를 실제로 근거 지은 immutable SourceRevision
  createdAt        DateTime       @default(now())
  wiki             Wiki           @relation(fields: [wikiId], references: [id], onDelete: Cascade)
  from             Page           @relation("ConceptRelFrom", fields: [fromPageId], references: [id], onDelete: Cascade)
  to               Page           @relation("ConceptRelTo", fields: [toPageId], references: [id], onDelete: Cascade)
  source           Source         @relation("SourceRelations", fields: [sourceId], references: [id], onDelete: Cascade)
  sourceRevision   SourceRevision @relation(fields: [sourceRevisionId], references: [id], onDelete: Cascade)

  @@unique([wikiId, fromPageId, toPageId, type, sourceRevisionId])
  @@index([wikiId, fromPageId]) // 정방향 확장
  @@index([wikiId, toPageId]) // 역방향 확장(무향 순회)
  @@index([sourceId]) // deleteSource cascade / provenance 조회
  @@index([sourceRevisionId])
}

model SearchChunk {
  id          String                       @id @default(cuid())
  wikiId      String
  refType     String // 'page' | 'source'
  refId       String
  heading     String                       @default("")
  text        String
  hash        String
  modelAccess ModelAccess                  @default(external)
  embedding   Unsupported("vector(1024)")?
  wiki        Wiki                         @relation(fields: [wikiId], references: [id], onDelete: Cascade)

  @@index([wikiId])
  @@index([wikiId, modelAccess])
  @@index([refType, refId])
}

model LogEntry {
  id        String   @id @default(cuid())
  wikiId    String
  kind      LogKind
  title     String
  detail    String   @default("")
  createdAt DateTime @default(now())
  wiki      Wiki     @relation(fields: [wikiId], references: [id], onDelete: Cascade)

  @@index([wikiId, createdAt])
}

model AgentRun {
  id                String           @id @default(cuid())
  wikiId            String
  userId            String?
  type              AgentType
  status            AgentStatus      @default(pending)
  stage             String? // running 중 현재 단계(fetch|curate|embed|lint). 단계 전이마다 갱신, 종료 시 null
  input             Json             @default("{}")
  output            Json?
  error             String?
  createdAt         DateTime         @default(now()) // 큐 진입(pending) 시각
  startedAt         DateTime? // running 전이 시각 — 대기 시간과 실제 실행 시간을 구분(경과시간·정직한 진행표시)
  finishedAt        DateTime?
  wiki              Wiki             @relation(fields: [wikiId], references: [id], onDelete: Cascade)
  knowledgeBuilds   KnowledgeBuild[]
  promotedSavedLink SavedLink?       @relation("SavedLinkPromotion")

  @@index([wikiId, createdAt])
}

model KnowledgeBuild {
  id                 String                       @id @default(cuid())
  wikiId             String
  agentRunId         String?
  createdById        String?
  mode               BuildMode
  status             BuildStatus                  @default(pending)
  model              String?
  promptVersion      String?
  rulesHash          String?
  inputManifest      Json                         @default("{}")
  publishedManifest  Json                         @default("{}")
  relationManifest   Json                         @default("[]")
  costUsd            Float?
  error              Json?
  restorable         Boolean                      @default(true)
  unrestorableReason String?
  forceExtraction    Boolean                      @default(false)
  createdAt          DateTime                     @default(now())
  startedAt          DateTime?
  finishedAt         DateTime?
  publishedAt        DateTime?
  wiki               Wiki                         @relation(fields: [wikiId], references: [id], onDelete: Cascade)
  agentRun           AgentRun?                    @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  drafts             KnowledgeDraft[]
  pageRevisions      PageRevision[]               @relation("BuildCreatedPageRevisions")
  pageManifest       KnowledgeBuildPageRevision[]
  extractions        KnowledgeBuildExtraction[]

  @@index([wikiId, createdAt])
  @@index([wikiId, status])
  @@index([agentRunId])
}

model SourceExtraction {
  id               String                     @id @default(cuid())
  sourceRevisionId String
  fingerprint      String
  model            String
  promptVersion    String
  rulesHash        String
  claims           Json                       @default("[]")
  concepts         Json                       @default("[]")
  entities         Json                       @default("[]")
  relations        Json                       @default("[]")
  sourceNote       Json                       @default("{}")
  createdAt        DateTime                   @default(now())
  sourceRevision   SourceRevision             @relation(fields: [sourceRevisionId], references: [id], onDelete: Cascade)
  buildUsages      KnowledgeBuildExtraction[]

  @@index([sourceRevisionId, fingerprint])
  @@index([createdAt])
}

model KnowledgeBuildExtraction {
  id                 String           @id @default(cuid())
  buildId            String
  sourceExtractionId String
  sourceRevisionId   String
  createdAt          DateTime         @default(now())
  build              KnowledgeBuild   @relation(fields: [buildId], references: [id], onDelete: Cascade)
  sourceExtraction   SourceExtraction @relation(fields: [sourceExtractionId], references: [id], onDelete: Cascade)
  sourceRevision     SourceRevision   @relation(fields: [sourceRevisionId], references: [id], onDelete: Cascade)

  @@unique([buildId, sourceRevisionId])
  @@index([sourceExtractionId])
  @@index([sourceRevisionId])
}

model KnowledgeDraft {
  id           String                 @id @default(cuid())
  buildId      String
  pageId       String?
  slug         String
  baseVersion  Int?
  status       DraftStatus            @default(staged)
  title        String
  body         String
  kind         PageKind
  frontmatter  Json                   @default("{}")
  category     String?
  documentType DocumentType?
  documentAt   DateTime?
  parentId     String?
  sortOrder    Int                    @default(0)
  origin       PageOrigin             @default(generated)
  modelAccess  ModelAccess            @default(external)
  archivedAt   DateTime?
  suppressedAt DateTime?
  staleAt      DateTime?
  contentHash  String
  validation   Json?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  build        KnowledgeBuild         @relation(fields: [buildId], references: [id], onDelete: Cascade)
  page         Page?                  @relation(fields: [pageId], references: [id], onDelete: SetNull)
  sources      KnowledgeDraftSource[]

  @@unique([buildId, slug])
  @@index([pageId])
  @@index([buildId, status])
}

model KnowledgeDraftSource {
  draftId          String
  sourceRevisionId String
  ordinal          Int?
  draft            KnowledgeDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  sourceRevision   SourceRevision @relation(fields: [sourceRevisionId], references: [id], onDelete: Cascade)

  @@id([draftId, sourceRevisionId])
  @@unique([draftId, ordinal])
  @@index([sourceRevisionId])
}

model KnowledgeBuildPageRevision {
  id             String         @id @default(cuid())
  buildId        String
  pageId         String
  pageRevisionId String
  slug           String
  createdAt      DateTime       @default(now())
  build          KnowledgeBuild @relation(fields: [buildId], references: [id], onDelete: Cascade)
  page           Page           @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageRevision   PageRevision   @relation(fields: [pageRevisionId], references: [id], onDelete: Cascade)

  @@unique([buildId, pageId])
  @@unique([buildId, pageRevisionId])
  @@index([pageRevisionId])
}

// 유저별 페이지 고정(개인 즐겨찾기). 위키 공유가 아니라 유저 스코프 — Page.pinned 컬럼이 아니라 별도 행.
model PagePin {
  id        String   @id @default(cuid())
  userId    String
  wikiId    String // 조회 스코프(denormalized, 해소된 위키에서 설정)
  pageId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wiki      Wiki     @relation(fields: [wikiId], references: [id], onDelete: Cascade)
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([userId, pageId]) // 토글 멱등
  @@index([userId, wikiId])
}

// 유저별 폴더(category 경로) 고정. PagePin은 pageId 전용이라 폴더는 별도 모델. 자주 여는 폴더 빠른 접근.
model FolderPin {
  id        String   @id @default(cuid())
  userId    String
  wikiId    String
  category  String // 폴더 경로(예: "ai/models"). category 라우트로 이동
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wiki      Wiki     @relation(fields: [wikiId], references: [id], onDelete: Cascade)

  @@unique([userId, wikiId, category]) // 토글 멱등
  @@index([userId, wikiId])
}

// 유저별 "읽을거리"(read-later) 링크. 개인·임시 트리아지 — 괜찮으면 정식 편입(ingest), 아니면 삭제.
// AI 코퍼스와 무관(SavedLink는 페이지가 아님). title/description은 저장 시 OG/메타태그로 자동 라벨(LLM 없음).
model SavedLink {
  id            String    @id @default(cuid())
  userId        String
  wikiId        String
  url           String
  title         String
  description   String?
  summary       String?
  trashedAt     DateTime?
  purgeAt       DateTime?
  promotedAt    DateTime? // 정식 편입(ingest) 시각. null=미편입. 편입해도 삭제하지 않고 이 값으로 "편입됨" 표시
  promotedRunId String?   @unique // promotion 재시도·동시 호출이 재사용하는 ingest run
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  wiki          Wiki      @relation(fields: [wikiId], references: [id], onDelete: Cascade)
  promotedRun   AgentRun? @relation("SavedLinkPromotion", fields: [promotedRunId], references: [id], onDelete: SetNull)

  @@index([userId, wikiId, createdAt])
  @@index([userId, wikiId, trashedAt])
  @@index([purgeAt])
}

// ---------- 텔레그램 봇 ----------
// 채팅(그룹/DM) → 위키 바인딩. chatId=텔레그램 chat.id(그룹은 음수·64비트 가능 → String). 채팅당 위키 1개.
model TelegramBinding {
  chatId      String   @id // 텔레그램 chat.id (문자열 보존)
  wikiId      String
  createdById String? // 바인딩을 건 텔레그램 유저 id(감사용, 소프트 참조)
  createdAt   DateTime @default(now())
  wiki        Wiki     @relation(fields: [wikiId], references: [id], onDelete: Cascade)

  @@index([wikiId])
}

// 봇 대화 기억(멀티턴). chatId별 최근 N턴을 로드해 툴 루프 history로 넣는다. 스칼라 위주(관계 미연결).
model TelegramTurn {
  id        String   @id @default(cuid())
  chatId    String
  role      String // "user" | "model"
  text      String
  createdAt DateTime @default(now())

  @@index([chatId, createdAt])
}
