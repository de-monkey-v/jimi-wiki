# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# ChatGPT(Codex) OAuth 토큰 저장소 — 민감 자격증명. 절대 커밋 금지.
.openai-oauth.json
.openai-oauth.json.tmp

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client (npx prisma generate로 재생성)
/src/generated/

# 개인 로컬 전용 (공개 배포 금지) — ChatGPT 구독 codex 프록시 등
/local/
