[Unit]
Description=Jimi Wiki encrypted database and blob backup

[Service]
Type=oneshot
WorkingDirectory=%h/.local/share/jimi-wiki/current
Environment=JIMI_STATE_DIR=%h/.local/share/jimi-wiki
ExecStart=%h/.local/share/jimi-wiki/current/ops/backup.sh
TimeoutStartSec=2h
UMask=0077
StandardOutput=journal
StandardError=journal
