[Unit]
Description=Jimi Wiki pinned Codex OAuth proxy
After=network-online.target
Wants=network-online.target
ConditionPathExists=%h/.codex/auth.json

[Service]
Type=simple
WorkingDirectory=%h/.local/share/jimi-wiki/current/ops/codex-proxy
ExecStart=/usr/bin/node ./node_modules/openai-oauth/dist/cli.js --host 127.0.0.1 --port 10531 --oauth-file %h/.codex/auth.json
Restart=always
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
