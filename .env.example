# Postgres (docker-compose)
DATABASE_URL="postgresql://jimi:jimi@localhost:5433/jimi?schema=public"

# 앱 공개 URL — 초대/공유 링크 절대경로 조립용 (예: http://oss-wsl:3007)
APP_URL="http://localhost:3007"

# Auth.js — 세션/JWT 서명 키 (openssl rand -base64 32)
AUTH_SECRET="dev-secret-change-me"

# 인증 모드: single | local | oidc
#   single = 로그인 없음, 암묵적 owner 1명 (순수 개인용 · localhost 전용 권장)
#   local  = 이메일+비밀번호(argon2id), 공개가입 off, 관리자 생성/초대 (기본 권장)
#   oidc   = 외부 OIDC provider 연결 (phase-2, 현재 미배선)
AUTH_MODE="local"

# first-run 관리자 부트스트랩 (pnpm db:seed 시 소비). 웹 /setup 을 쓰면 비워둬도 됨.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Per-user daily generative-token ceiling
DAILY_TOKEN_LIMIT="3000000"

# Gemini API 키 (생성 + 임베딩). https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# @ai-sdk/google 용 (GEMINI_API_KEY와 동일 값)
GOOGLE_GENERATIVE_AI_API_KEY=""

# (선택) Anthropic API 키 — INGEST_MODEL을 claude-* 로 지정할 때 필요
ANTHROPIC_API_KEY=""

# (선택) ingest 에이전트 모델 오버라이드. 미설정 시 gemini-3.1-pro-preview
# INGEST_MODEL="claude-sonnet-5"

# Worker polling interval
WORKER_POLL_MS="3000"

# --- 제거됨 (self-host local 인증으로 전환) ---
# AUTH_GITHUB_ID / AUTH_GITHUB_SECRET — GitHub OAuth 폐기
# INVITE_EMAILS — 인스턴스 Invite 모델(관리자 발급)로 대체
# DEV_USER_EMAIL — dev 쿠키 로그인 폐기, AUTH_MODE=single 로 대체
