# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# ChatGPT(Codex) OAuth 토큰 저장소 — 민감 자격증명. 절대 커밋 금지.
.openai-oauth.json
.openai-oauth.json*.tmp

# models.dev 카탈로그 디스크 캐시(런타임 생성)
.model-catalog.cache.json*

# 업로드 원본 파일(blob) 로컬 저장소(런타임 생성). BLOB_DIR 미설정 시 기본 경로.
/.blobs/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client (npx prisma generate로 재생성)
/src/generated/

# 개인 로컬 전용 (공개 배포 금지) — ChatGPT 구독 codex 프록시 등
/local/

# Playwright MCP 브라우저 검증 산출물(스냅샷·콘솔 로그)
/.playwright-mcp/

# Claude Code 머신 로컬 설정(권한 허용 목록 등). 공유 설정은 .agents/에 둔다.
/.claude/settings.local.json

# 릴리스 스킬의 python 스크립트를 실행하면 남는 바이트코드 캐시.
# .agents/skills/*/scripts 는 추적 대상이라 이것들이 그대로 커밋에 딸려 들어간다.
__pycache__/
*.py[cod]
.pytest_cache/
