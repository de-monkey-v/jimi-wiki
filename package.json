{
  "name": "jimi-wiki-app",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/run-dev-db-command.mjs dev",
    "dev:all": "node scripts/run-dev-db-command.mjs dev-all",
    "start:all": "tsx scripts/dev-all.ts start",
    "build": "next build",
    "start": "next start -p 23007",
    "worker": "NODE_OPTIONS='-r ./scripts/server-only-shim.cjs' tsx scripts/worker.ts",
    "worker:dev": "node scripts/run-dev-db-command.mjs worker",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS='-r ./scripts/server-only-shim.cjs' node --import tsx --test src/lib/*.test.ts",
    "test:integration": "NODE_OPTIONS='-r ./scripts/server-only-shim.cjs' node --import tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "lint": "eslint",
    "db:up": "docker compose up -d db",
    "db:up:embedding": "docker compose --profile embedding up -d",
    "db:down": "docker compose down",
    "db:seed": "node scripts/run-dev-db-command.mjs seed",
    "db:migrate": "node scripts/run-dev-db-command.mjs migrate",
    "db:migrate:create": "node scripts/run-dev-db-command.mjs migrate:create",
    "apikey:issue": "tsx scripts/issue-api-key.ts",
    "reindex": "NODE_OPTIONS='-r ./scripts/server-only-shim.cjs' tsx scripts/reindex-embeddings.ts",
    "telegram:seed": "NODE_OPTIONS='-r ./scripts/server-only-shim.cjs' tsx scripts/telegram-seed.ts",
    "telegram:webhook": "tsx scripts/telegram-setup-webhook.ts",
    "telegram:simulate": "tsx scripts/telegram-simulate.ts",
    "backfill:sources": "NODE_OPTIONS='-r ./scripts/server-only-shim.cjs' tsx scripts/backfill-orphan-source-notes.ts",
    "refetch:source": "NODE_OPTIONS='-r ./scripts/server-only-shim.cjs' tsx scripts/refetch-source-body.ts",
    "openai:login": "tsx scripts/openai-login.ts",
    "openai:smoke": "NODE_OPTIONS='-r ./scripts/server-only-shim.cjs' tsx scripts/openai-oauth-smoke.ts",
    "openai:configure-test": "NODE_OPTIONS='-r ./scripts/server-only-shim.cjs' tsx scripts/configure-test-models.ts",
    "reset:test-content": "NODE_OPTIONS='-r ./scripts/server-only-shim.cjs' tsx scripts/reset-test-content.ts",
    "smoke": "node scripts/run-dev-db-command.mjs smoke",
    "check:rules": "node scripts/check-rules-parity.mjs",
    "check:content-writes": "node scripts/check-content-writes.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "content:manifest": "tsx scripts/content-manifest.ts",
    "auth:reset-personal": "NODE_OPTIONS='-r ./scripts/server-only-shim.cjs' tsx scripts/reset-personal-auth.ts",
    "tailscale:recover": "NODE_OPTIONS='-r ./scripts/server-only-shim.cjs' tsx scripts/recover-tailscale-account.ts",
    "apikey:issue-hermes": "NODE_OPTIONS='-r ./scripts/server-only-shim.cjs' tsx scripts/issue-hermes-key.ts",
    "apikey:check-hermes-expiry": "NODE_OPTIONS='-r ./scripts/server-only-shim.cjs' tsx scripts/check-hermes-key-expiry.ts",
    "mcp": "node mcp/server.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.88",
    "@ai-sdk/openai": "^3.0.80",
    "@ai-sdk/react": "^4.0.40",
    "@anthropic-ai/sdk": "^0.114.0",
    "@auth/prisma-adapter": "^2.11.3",
    "@extractus/article-extractor": "^8.1.0",
    "@google/genai": "^2.13.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@prisma/client-runtime-utils": "^7.9.0",
    "@sigma/node-border": "3.0.0",
    "@streamdown/mermaid": "1.0.2",
    "ai": "^6.0.218",
    "diff": "9.0.0",
    "dotenv": "^17.4.2",
    "github-slugger": "^2.0.0",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "graphology-layout-noverlap": "0.4.2",
    "mammoth": "^1.12.0",
    "next": "16.2.11",
    "next-auth": "5.0.0-beta.31",
    "next-intl": "4.13.4",
    "officeparser": "^7.4.0",
    "pg": "^8.22.0",
    "prisma": "^7.9.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sigma": "^3.0.3",
    "streamdown": "2.5.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "unpdf": "^1.7.0",
    "yauzl": "^3.4.0",
    "youtube-caption-extractor": "^1.10.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yauzl": "^3.4.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
