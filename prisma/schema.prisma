// jimi-wiki 플랫폼 데이터 모델 — docs/jimi-wiki-platform.md §4 참조
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  output          = "../src/generated/prisma"
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// ---------- enums ----------
enum Role {
  owner
  editor
  viewer
}

enum Visibility {
  private
  unlisted
  public
}

enum WikiKind {
  personal
  project
  channel
}

enum PageKind {
  note
  concept
  entity
  meta
}

enum LogKind {
  ingest
  query
  lint
  ontology
}

enum AgentType {
  ingest
  query
  lint
}

enum AgentStatus {
  pending
  running
  done
  error
}

// ---------- 앱 전역 설정 (단일행) ----------
// 런타임에 UI(관리자)에서 바꾸는 설정. env 는 미설정 시 폴백. web·worker 가 같은 행을 읽는다.
// ⚠️ EMBED_MODEL/EMBED_DIM 은 DB vector 컬럼·HNSW 인덱스와 결합되어 여기 두지 않는다(env 고정).
model AppConfig {
  id               String   @id @default("singleton")
  chatModel        String? // 위키 채팅. null=env CHAT_MODEL 폴백
  genModel         String? // query·lint 등 일반 생성. null=env GEN_MODEL 폴백
  ingestModel      String? // ingest 에이전트. null=env INGEST_MODEL 폴백
  openaiTransport  String? // OpenAI 연결 방식: apikey|oauth|proxy. null=env(OPENAI_TRANSPORT)/auto 폴백
  // opt-in: 관리자가 명시적으로 켠 provider 만 사용(키 존재 ≠ 자동 사용). 값: google|openai|anthropic.
  // 행이 없을 때만 env ENABLED_PROVIDERS 로 폴백(스칼라 배열은 null 불가).
  enabledProviders String[] @default([])
  updatedAt        DateTime @updatedAt
}

// ---------- 인증 (Auth.js) ----------
model User {
  id             String       @id @default(cuid())
  email          String       @unique
  name           String?
  image          String?
  emailVerified  DateTime?
  passwordHash   String? // argon2id 해시. null=비밀번호 미설정(oidc/single/미부트스트랩 기존 유저)
  isAdmin        Boolean      @default(false) // 인스턴스 관리자(유저·초대 관리 권한). 위키별 Role과 직교
  createdAt      DateTime     @default(now())
  accounts       Account[] // 유지(JWT 전환 후 idle) — oidc 확장 시 재사용
  sessions       Session[] // 유지(JWT 전환 후 idle)
  memberships    Membership[]
  createdWikis   Wiki[]       @relation("WikiCreatedBy")
  apiKeys        ApiKey[]
  createdInvites Invite[]     @relation("InviteCreatedBy")
}

// ---------- 인스턴스 계정 초대 (가입 게이트) ----------
// ShareLink(위키 스코프 공유)와 달리 wikiId가 선택이며 '새 유저 계정 발급'을 의미한다.
// 공개 회원가입은 없다 — 관리자가 발급한 이 토큰으로만 계정을 만들 수 있다.
model Invite {
  id           String    @id @default(cuid())
  token        String    @unique // 고엔트로피 무작위(crypto.randomBytes(24).base64url). 초대 URL에 실림
  email        String? // 지정 시 이 이메일만 가입 허용
  wikiId       String? // 지정 시 가입과 동시에 이 위키 멤버로 추가. null=계정만 생성
  role         Role      @default(viewer) // wikiId가 있을 때 부여할 위키 역할
  expiresAt    DateTime? // null=무만료. now 이후면 사용 불가
  usedAt       DateTime? // 소비 시각(1회용 게이트). null=미사용
  usedByUserId String? // 이 초대로 가입한 유저(소프트 참조)
  createdById  String
  createdAt    DateTime  @default(now())
  createdBy    User      @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  wiki         Wiki?     @relation(fields: [wikiId], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@index([wikiId])
}

// ---------- API 키 인증 (프로그램적 호출용 Bearer 토큰) ----------
// 브라우저는 세션(위 Session/Account) 유지, API 라우트는 이 토큰으로 인증.
// 원문 키는 저장하지 않는다 — sha256(hashedKey)만 저장, prefix는 노출용 식별자.
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  wikiId     String? // 스코프 위키 — null=전체 위키(레거시). 값이 있으면 그 위키에서만 유효
  name       String // 사람이 식별하는 라벨 ("ingest-bot" 등)
  hashedKey  String    @unique // sha256(token) hex, 조회·비교 대상
  prefix     String // 토큰 앞부분(비밀 아님) — UI 표시/키 구분용
  maxRole    Role? // 상한 역할 — null=다운그레이드 없음(멤버십 역할 그대로). 유효역할=min(멤버십, maxRole)
  expiresAt  DateTime? // 만료 시각 — null=무만료. now 이후면 인증 실패
  revokedAt  DateTime? // 폐기 시각(soft-revoke) — null=활성. 하드삭제 대신 이 값을 채운다
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  wiki       Wiki?     @relation(fields: [wikiId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([wikiId])
}

// ---------- 사용량 계측 (LLM/임베딩 호출 단위 이벤트) ----------
// 스칼라 위주(관계 미연결) — 계측은 fire-and-forget이라 FK 제약/조인 비용을 피한다.
// userId/apiKeyId/wikiId는 컨텍스트가 있을 때만 채워지는 소프트 참조.
model UsageEvent {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  userId       String? // 호출 주체(세션/키 소유자). 컨텍스트 없으면 null
  apiKeyId     String? // API 키 호출이면 그 키 id
  wikiId       String? // 대상 위키
  kind         String // "llm" | "embed"
  route        String   @default("") // 호출 출처("query"|"ingest"|"chat"|"lint"|"search"|"reindex" 등)
  model        String? // 사용 모델명
  inputTokens  Int?
  outputTokens Int?
  costUsd      Float?

  @@index([userId, createdAt])
  @@index([wikiId, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- 테넌트 ----------
model Wiki {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  description String?
  visibility  Visibility   @default(private)
  kind        WikiKind     @default(personal)
  createdById String
  createdBy   User         @relation("WikiCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
  pages       Page[]
  pageLinks   PageLink[]
  sources     Source[]
  chunks      SearchChunk[]
  logs        LogEntry[]
  shareLinks  ShareLink[]
  agentRuns   AgentRun[]
  apiKeys     ApiKey[]
  invites     Invite[]
}

model Membership {
  id        String   @id @default(cuid())
  wikiId    String
  userId    String
  role      Role     @default(owner)
  createdAt DateTime @default(now())
  wiki      Wiki     @relation(fields: [wikiId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([wikiId, userId])
  @@index([userId])
}

model ShareLink {
  id        String    @id @default(cuid())
  wikiId    String
  token     String    @unique
  role      Role      @default(viewer)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  wiki      Wiki      @relation(fields: [wikiId], references: [id], onDelete: Cascade)
}

// ---------- 콘텐츠 ----------
model Page {
  id          String     @id @default(cuid())
  wikiId      String
  slug        String
  title       String
  kind        PageKind   @default(note)
  frontmatter Json       @default("{}")
  body        String     @default("")
  sortOrder   Int        @default(0) // 형제 페이지 간 순서(책 목차)
  parentId    String? // 상위 페이지(챕터). 루트는 null
  category    String? // 자유형 폴더 경로(예: "ai/architectures"). 온톨로지 조직 축
  sourceId    String? // 이 페이지가 파생된 원문(provenance). note에 주로 연결
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  wiki        Wiki       @relation(fields: [wikiId], references: [id], onDelete: Cascade)
  parent      Page?      @relation("PageTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Page[]     @relation("PageTree")
  source      Source?    @relation("PageSource", fields: [sourceId], references: [id], onDelete: SetNull)
  outLinks    PageLink[] @relation("PageOut")
  inLinks     PageLink[] @relation("PageIn")
  contributions PageContribution[] // 이 파생 페이지에 기여한 원본들(M:N provenance)

  @@unique([wikiId, slug])
  @@index([wikiId, kind])
  @@index([wikiId, parentId, sortOrder])
  @@index([wikiId, category])
}

model PageLink {
  id         String  @id @default(cuid())
  wikiId     String
  fromPageId String
  toSlug     String
  toPageId   String?
  wiki       Wiki    @relation(fields: [wikiId], references: [id], onDelete: Cascade)
  from       Page    @relation("PageOut", fields: [fromPageId], references: [id], onDelete: Cascade)
  to         Page?   @relation("PageIn", fields: [toPageId], references: [id], onDelete: SetNull)

  @@index([wikiId, toPageId])
  @@index([wikiId, toSlug])
  @@index([fromPageId])
}

model Source {
  id         String   @id @default(cuid())
  wikiId     String
  slug       String
  title      String
  url        String?
  body       String?
  storageKey String?
  ingestedAt DateTime @default(now())
  wiki       Wiki     @relation(fields: [wikiId], references: [id], onDelete: Cascade)
  pages      Page[]   @relation("PageSource")
  contributions PageContribution[] @relation("SourceContribs") // 이 원본이 기여한 파생 페이지들

  @@unique([wikiId, slug])
}

// 파생 페이지(concept/entity) ↔ 기여 원본(Source)의 M:N. note의 단일 Page.sourceId와 별개.
model PageContribution {
  id       String @id @default(cuid())
  wikiId   String
  pageId   String
  sourceId String
  page     Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  source   Source @relation("SourceContribs", fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([pageId, sourceId])
  @@index([sourceId])
}

model SearchChunk {
  id        String                       @id @default(cuid())
  wikiId    String
  refType   String // 'page' | 'source'
  refId     String
  heading   String                       @default("")
  text      String
  hash      String
  embedding Unsupported("vector(768)")?
  wiki      Wiki                         @relation(fields: [wikiId], references: [id], onDelete: Cascade)

  @@index([wikiId])
  @@index([refType, refId])
}

model LogEntry {
  id        String   @id @default(cuid())
  wikiId    String
  kind      LogKind
  title     String
  detail    String   @default("")
  createdAt DateTime @default(now())
  wiki      Wiki     @relation(fields: [wikiId], references: [id], onDelete: Cascade)

  @@index([wikiId, createdAt])
}

model AgentRun {
  id         String      @id @default(cuid())
  wikiId     String
  userId     String?
  type       AgentType
  status     AgentStatus @default(pending)
  input      Json        @default("{}")
  output     Json?
  error      String?
  createdAt  DateTime    @default(now())
  finishedAt DateTime?
  wiki       Wiki        @relation(fields: [wikiId], references: [id], onDelete: Cascade)

  @@index([wikiId, createdAt])
}
