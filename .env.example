# Postgres (docker-compose) — 두 값의 password를 같은 랜덤 값으로 바꾸세요.
POSTGRES_PASSWORD="replace-with-a-long-random-value"
DATABASE_URL="postgresql://jimi:replace-with-a-long-random-value@127.0.0.1:5433/jimi?schema=public"

# 앱 공개 URL — 초대/공유 링크 절대경로 조립용 (예: http://oss-wsl:3007)
APP_URL="http://localhost:3007"

# Auth.js — 세션/JWT 서명 키 (openssl rand -base64 32)
AUTH_SECRET="dev-secret-change-me"

# 인증 모드: single | local | tailscale | oidc
#   single = 로그인 없음, 암묵적 owner 1명 (순수 개인용 · localhost 전용 권장)
#   local  = 이메일+비밀번호(argon2id), 공개가입 off, 관리자 생성/초대 (기본 권장)
#   tailscale = Tailscale Serve identity header + 허용 login 1명을 기존 owner에 claim
#   oidc   = 외부 OIDC provider 연결 (phase-2, 현재 미배선)
AUTH_MODE="local"
# AUTH_MODE=tailscale일 때 필수. Serve의 Tailscale-User-Login과 정확히 일치해야 함.
TAILSCALE_ALLOWED_LOGIN=""

# first-run 관리자 부트스트랩 (pnpm db:seed 시 소비). 웹 /setup 을 쓰면 비워둬도 됨.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Per-user daily generative-token ceiling
DAILY_TOKEN_LIMIT="3000000"

# ⚠️ 비용 안전 · 키 격리: 아래 키들은 process.env 에서 읽힌다. 표준(Next/dotenv) 우선순위상
#   셸에 export된 키가 이 .env 보다 우선한다 → .zshrc 등의 개인 키가 무심코 과금될 수 있다.
#   격리하려면 (a) Docker(컨테이너는 셸 env 미상속, .env 만 사용) 또는 (b) 셸에 키를 두지 말고 .env 에만.
#   확인: `env | grep -E 'OPENAI|GEMINI|ANTHROPIC|_API_KEY'` · worker 시작 로그가 활성 키의 출처를 표시.
#   권장: 이 앱 전용 키를 발급하고 provider 콘솔에서 사용량 상한(budget)을 걸어둘 것. 자세히는 README "API 키 격리·비용 안전".

# Gemini API 키 (생성 + 임베딩). https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# @ai-sdk/google 용 (GEMINI_API_KEY와 동일 값)
GOOGLE_GENERATIVE_AI_API_KEY=""

# (선택) Anthropic API 키 — INGEST_MODEL 등을 claude-* 로 지정할 때 필요
ANTHROPIC_API_KEY=""

# (선택) OpenAI API 키 — 모델을 gpt-* / o* 로 지정할 때 필요(chat·ingest·lint)
OPENAI_API_KEY=""
# (선택·개인 로컬 전용) OpenAI 호환 프록시 base URL. 외부 codex-auth 프록시를 직접 띄워 태울 때만.
# OPENAI_BASE_URL="http://localhost:8787/v1"
#
# (선택·개인 로컬 전용) ChatGPT 구독 OAuth 를 앱에 직접 태우기 — 별도 프록시 불필요.
#   1) `pnpm openai:login` 으로 브라우저 로그인(토큰은 .openai-oauth.json 에 저장, gitignore 됨)
#   2) 아래를 1 로 켜고 CHAT_MODEL/GEN_MODEL/INGEST_MODEL 을 gpt-* 로 지정
# OPENAI_BASE_URL 이 설정돼 있으면 그쪽이 우선한다.
# ⚠️ 개인 self-host 전용 — 개인 ChatGPT 구독을 나 혼자 쓰는 용도. 여러 사람에게 서비스로 열지 말 것(약관).
# OPENAI_OAUTH_PERSONAL="1"
#
# (선택·부트스트랩) OpenAI 연결 방식: apikey | oauth | proxy. /admin/settings 에서 관리자가 선택하는 값의
# 최초 폴백이다. 미설정 시 자동 추론(OPENAI_BASE_URL 있으면 proxy, OPENAI_OAUTH_PERSONAL=1 이면 oauth, 아니면 apikey).
# 설정을 저장한 뒤엔 UI 선택이 우선한다.
# OPENAI_TRANSPORT="apikey"
# (선택) 토큰 저장 경로 오버라이드. 기본: <cwd>/.openai-oauth.json
# OPENAI_OAUTH_STORE=""

# provider 사용 가능 여부는 별도 설정이 없다 — 키/OAuth 자격증명이 있는 provider는 그대로 chat·query·lint·번역에
# 자동으로 쓰인다(예: GEMINI_API_KEY 만 있으면 Google 전부 동작). 어떤 모델을 쓸지는 아래 *_MODEL 로 고른다.

# --- 모델 선택 (미설정 시 아래 기본값). gemini-* | claude-* | gpt-*/o* 혼용 가능 ---
# 참고: 아래 CHAT/GEN/INGEST_MODEL 은 관리자 페이지 /admin/settings 에서 런타임에 덮어쓸 수 있다(재시작 불필요).
#       여기 값은 DB 설정이 없을 때의 폴백이다. EMBED_MODEL/EMBED_DIM 은 env 전용(스키마 결합).
# --- 임베딩 (검색·색인) ---
# EMBED_PROVIDER: local = 자가호스팅(docker-compose 의 embeddings 서비스, bge-m3) / gemini = Google API.
#   미지정이면 EMBED_BASE_URL 이 있을 때만 local, 없으면 gemini.
#   local 을 쓰면 임베딩에 외부 API 키가 필요 없다(생성 모델과 별개).
#   프로바이더를 바꾸면 벡터 공간이 달라지므로 **전체 재색인**이 필요하다(스키마 변경은 불필요 — 둘 다 1024).
EMBED_PROVIDER="local"
# local 임베딩 서버(TEI) 주소. docker-compose 로 띄우면 http://embeddings:80,
# 호스트에서 직접 띄웠다면 http://127.0.0.1:8080 처럼 지정한다.
EMBED_BASE_URL="http://127.0.0.1:8080"
# 모델명. 미지정 시 local=BAAI/bge-m3, gemini=gemini-embedding-001.
#   local 에서는 docker-compose 의 embeddings 서비스가 이 값을 그대로 --model-id 로 서빙한다(단일 소스).
#   한국어 위주라면 KURE-v1 권장 — bge-m3 를 한국어로 파인튜닝한 모델(1024차원·MIT 동일)이라
#   모델명만 바꾸고 재색인하면 교체된다. 다국어 균형을 원하면 BAAI/bge-m3.
# EMBED_MODEL="nlpai-lab/KURE-v1"
#   ⚠️ EMBED_DIM 변경 = DB의 vector(N) 컬럼·HNSW 인덱스 마이그레이션 + 전체 재색인 필요. 함부로 바꾸지 말 것.
#      bge-m3 는 1024 고정이고, gemini-embedding-001 은 MRL 로 1024 를 낼 수 있어 값을 통일해 쓴다.
EMBED_DIM="1024"
# ingest 에이전트 (원문 편입·큐레이션). gemini-* 또는 claude-*(claude면 ANTHROPIC_API_KEY 필요).
INGEST_MODEL="gemini-3.1-pro-preview"
# query·lint 등 일반 생성(툴콜 루프).
GEN_MODEL="gemini-2.5-flash"
# 위키 채팅.
CHAT_MODEL="gemini-2.5-flash"

# Worker polling interval
WORKER_POLL_MS="3000"

# production release 간 공유할 절대 경로(예: ~/.local/share/jimi-wiki/shared/*).
BLOB_DIR=""
MODEL_CATALOG_CACHE=""

# --- 텔레그램 봇 (선택) — 설정하면 /api/telegram/webhook 활성 ---
# @BotFather 로 봇을 만들고 발급받은 토큰. 비우면 봇 비활성(웹훅이 503).
TELEGRAM_BOT_TOKEN=""
# 웹훅 검증 시크릿 — setWebhook 의 secret_token 으로 등록하고 매 요청 헤더와 상수시간 비교.
#   생성 예: openssl rand -hex 32. 봇 토큰과 별개의 임의 문자열.
TELEGRAM_WEBHOOK_SECRET=""

# --- KG(지식 그래프) 검색 확장 — GraphRAG. 쿼리시각 튜닝 노브(env 전용, 스키마 결합 없음) ---
# 질의 답변 시 개념 간 타입드 관계(ConceptRelation)를 따라 이웃 개념을 컨텍스트에 보강한다.
# 미설정 시 아래 기본값. 값을 바꾸면 재배포로 반영(핫리로드 아님).
#   KG_MAX_HOP: 확장 최대 홉수(코드 상한 4). 0 = 킬스위치(확장 완전 비활성 → 순수 hybridSearch).
#   KG_SIM_CUTOFF: 이 코사인 유사도 미만이면 seed가 약하다고 보고 확장 폭을 넓힌다(벡터신호 있을 때만).
#   KG_HUB_CAP: 노드당 fan-out 상한(차수 큰 허브에서 확장 중단 → 순회 폭발·노이즈 방지). seed에는 미적용.
#   KG_NODE_BUDGET: 컨텍스트에 넣는 이웃 개념 수 하드캡(LLM 컨텍스트 bloat·인용 희석 방지).
# KG_MAX_HOP="2"
# KG_SIM_CUTOFF="0.55"
# KG_HUB_CAP="25"
# KG_NODE_BUDGET="12"

# --- 제거됨 (self-host local 인증으로 전환) ---
# AUTH_GITHUB_ID / AUTH_GITHUB_SECRET — GitHub OAuth 폐기
# INVITE_EMAILS — 인스턴스 Invite 모델(관리자 발급)로 대체
# DEV_USER_EMAIL — dev 쿠키 로그인 폐기, AUTH_MODE=single 로 대체
