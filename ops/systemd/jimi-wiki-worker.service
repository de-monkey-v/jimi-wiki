[Unit]
Description=Jimi Wiki production ingest worker
After=network-online.target jimi-wiki-web.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/jimi-wiki/current
EnvironmentFile=%h/.config/jimi-wiki/app.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node --require ./scripts/server-only-shim.cjs --import tsx ./scripts/worker.ts
Restart=always
RestartSec=5
TimeoutStopSec=45
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
